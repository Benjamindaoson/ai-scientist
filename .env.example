# PostgreSQL is the canonical Research OS scientific store.
RESEARCH_DATABASE_URL=postgresql+psycopg://research:research@localhost:55432/research_os
RESEARCH_ARTIFACT_ROOT=./research_output/artifacts
RESEARCH_CODEX_EXECUTABLE=codex
RESEARCH_CODEX_TIMEOUT_SECONDS=900
RESEARCH_LATEX_COMPILER=
RESEARCH_BROWSER_ENABLED=false
RESEARCH_RPA_ENABLED=false
RESEARCH_PAID_API_ENABLED=false
RESEARCH_LITERATURE_ROOT=./research_output/artifacts/literature
RESEARCH_EMBEDDING_MODEL=BAAI/bge-m3
RESEARCH_CONFERENCE_YEARS=2022,2023,2024,2025,2026
RESEARCH_RESOURCE_BUDGET_JSON={"max_experiment_minutes":60,"max_agent_tasks":50}
RESEARCH_LOG_LEVEL=INFO
